  "keyFeatures": [
    "Anti-Raid Protection — detects and blocks coordinated join floods and raid attempts",
    "Anti-Nuke — prevents destructive actions such as mass channel/role deletions",
    "Anti-Spam — rate-limits and filters message spam, mentions, and repeated content",
    "Anti-Bot — blocks known malicious bots and suspicious automated accounts",
    "Member Verification — CAPTCHA and gate-based verification before server access",
    "Security Logs — detailed audit logs for all security events and actions taken",
    "Threat Detection — real-time scoring and flagging of suspicious user behavior",
    "Whitelist System — trusted users and roles exempt from security restrictions",
    "Slash Command Interface — all configuration and moderation via Discord slash commands",
    "Configurable Thresholds — fine-grained tuning of every security module"
  ],
  "publicApiSurface": [
    "/harbor setup — initial bot configuration wizard",
    "/harbor anti-raid — configure raid protection settings",
    "/harbor anti-nuke — configure nuke protection settings",
    "/harbor anti-spam — configure spam protection settings",
    "/harbor anti-bot — configure bot detection settings",
    "/harbor verify — manage member verification settings",
    "/harbor logs — configure security log channel",
    "/harbor whitelist add/remove — manage trusted users and roles",
    "/harbor config — view and edit full configuration",
    "/harbor ban/kick/mute/warn — moderation commands",
    "/harbor status — view current security status and module states",
    "/harbor reset — reset configuration to defaults"
  ]
